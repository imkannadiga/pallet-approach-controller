<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://relaxng.org/ns/structure/1.0"?>
<package format="3">
  <name>pallet_approach</name>
  <version>0.1.0</version>
  <description>
    Geometry-driven pallet perception and fork-insertion approach for an AgileX
    SCOUT 2.0 with a ZED 2i stereo camera.
  </description>
  <maintainer email="athreyahosahalliprakash@gmail.com">Athreya</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>pallet_approach_interfaces</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>tf2_geometry_msgs</exec_depend>
  <exec_depend>lifecycle_msgs</exec_depend>
  <exec_depend>diagnostic_msgs</exec_depend>
  <!-- Arbitration: the launch file starts it, and without it nothing
       this stack publishes reaches the base (D30, D31). -->
  <exec_depend>twist_mux</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-sklearn</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <!-- video_stream.py / nodes/video_streamer.py: the GStreamer pipeline that
       feeds MediaMTX. The GStreamer plugin packages themselves (gstreamer1.0-*)
       are not rosdep-tracked Python dependencies, so the Dockerfile installs
       them directly via apt rather than through this file; python3-gi is
       listed here too for documentation, since it is the one of the group
       that is actually `import`ed from Python. -->
  <exec_depend>python3-gi</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
